{
  "name": "sjaquer-web",
  "version": "2.0.0",
  "private": true,
  "description": "Portafolio de Sebastián Jaque — desarrollo web, automatización de procesos e integraciones. Next.js 16 + MDX.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "lhci": "lhci autorun",
    "cv:pdf": "scripts/cv-pdf.sh",
    "brand": "node scripts/brand/build-assets.mjs && scripts/brand/render-png.sh",
    "brand:figma": "node scripts/brand/figma-kit.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.4.0",
    "@tabler/icons-react": "^3.46.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.9.1",
    "eslint-config-next": "^16.4.0",
    "opentype.js": "^2.0.0",
    "postcss": "^8.4.35",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.11.2"
}
